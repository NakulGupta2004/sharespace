{
  "watch": [
    "server.js",
    "routes/",
    "models/",
    "middleware/",
    "config/",
    "utils/",
    ".env"
  ],
  "ext": "js,json,env",
  "ignore": [
    "node_modules/",
    "logs/",
    "uploads/",
    "*.test.js",
    "*.spec.js",
    ".git/",
    "README.md",
    "package*.json"
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": true,
  "restartable": "rs",
  "colours": true,
  "legacyWatch": false
}